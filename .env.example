# ==============================================================================
# Hisabo - Environment Configuration Template
# NOTE: Copy this file to '.env' and fill in your private values.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Application Environment
APP_ENV=production
APP_PORT=3000

# GitHub Configuration (if integrating GitHub API / Sync)
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_USERNAME=your_username_here
GITHUB_REPO=Hisabo

# Optional Cloud Storage / Backup API Keys (if enabled in future)
# STORAGE_API_KEY=your_secret_api_key_here
# ENCRYPTION_SECRET=your_client_encryption_secret_here
