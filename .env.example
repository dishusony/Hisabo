# ==============================================================================
# Hisabo - Environment Configuration Template
# ==============================================================================
# SECURITY POLICY:
# 1. Store all private tokens, credentials, and API keys strictly in '.env'.
# 2. Never commit '.env' or any '.env.*' file to Git (enforced in .gitignore).
# 3. All secrets are loaded server-side only in Node.js (process.env).
# 4. Client-side JavaScript running in the browser NEVER receives or bundles
#    private tokens. Any API requests requiring secret keys must be handled
#    via secure backend server routes.
# ==============================================================================

# Application Environment
APP_ENV=production
APP_PORT=3000

# GitHub Configuration (if integrating GitHub API / automated release scripts)
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_USERNAME=your_username_here
GITHUB_REPO=Hisabo

# Google Sign-In / Gmail Authentication (Optional - for Google Identity Services)
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Gmail SMTP Budget Alerts Configuration (50%, 90%, 100% threshold notifications)
# Generate a 16-character Google App Password: myaccount.google.com -> Security -> 2-Step Verification -> App Passwords
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_character_app_password

# AI & Third-Party APIs (kept exclusively on backend server, never sent to browser)
# GEMINI_API_KEY=your_gemini_api_key_here
# DATABASE_URL=postgresql://user:password@localhost:5432/hisabo
# BACKUP_ENCRYPTION_KEY=your_strong_random_encryption_key_here

