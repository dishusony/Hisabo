# ==============================================================================
# Hisabo - Environment Configuration Template
# ==============================================================================
# SECURITY POLICY:
# 1. Store all private tokens, credentials, and API keys strictly in '.env'.
# 2. Never commit '.env' or any '.env.*' file to Git (enforced in .gitignore).
# 3. All secrets are loaded server-side only in Node.js (process.env).
# 4. Client-side JavaScript running in the browser NEVER receives or bundles
#    private tokens.
# ==============================================================================

# Application Environment & Server
APP_ENV=production
APP_PORT=3000
APP_URL=http://localhost:3000

# Database Storage Path
# Local default: data/hisabo.sqlite
# Vercel serverless default: /tmp/hisabo.sqlite
# DATABASE_PATH=data/hisabo.sqlite

# ==============================================================================
# 100% FREE (₹0) Real Email Delivery for Gmail OTP Verification & Budget Alerts
# Choose AT LEAST ONE of the following genuinely free options:
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1 (RECOMMENDED FOR STUDENTS - ₹0, No Domain, No Credit Card):
# Google Official Gmail SMTP (500 free emails/day forever)
# ------------------------------------------------------------------------------
# HOW TO GET YOUR 16-CHARACTER GOOGLE APP PASSWORD (Takes 60 seconds):
# 1. Open your Google Account: https://myaccount.google.com/security
# 2. Under 'How you sign in to Google', make sure '2-Step Verification' is ON.
# 3. Go to: https://myaccount.google.com/apppasswords
#    (or search "App passwords" in your Google Account search bar).
# 4. Enter 'Hisabo' as the App name and click 'Create'.
# 5. Copy the generated 16-character code (e.g. 'abcd efgh ijkl mnop').
# 6. Paste your Gmail and App Password below:
# GMAIL_USER=yourname@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop

# ------------------------------------------------------------------------------
# OPTION 2 (ALTERNATIVE FREE REST API - ₹0, No Domain, No Credit Card):
# Brevo / Sendinblue REST API (300 free emails/day forever)
# ------------------------------------------------------------------------------
# 1. Create a free account at https://www.brevo.com (No credit card required).
# 2. Verify your personal @gmail.com by clicking the link Brevo sends to your inbox.
# 3. Go to SMTP & API -> API Keys -> Generate a new key.
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# BREVO_SENDER_EMAIL=yourname@gmail.com

# ------------------------------------------------------------------------------
# OPTION 3 (OPTIONAL - For Custom Domain Owners):
# Resend REST API (https://resend.com)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=Hisabo <onboarding@resend.dev>

# ==============================================================================
# Google Sign-In (Optional - for Google Identity Services One-Tap)
# ==============================================================================
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
